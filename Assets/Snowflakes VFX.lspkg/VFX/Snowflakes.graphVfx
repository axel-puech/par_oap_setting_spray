    Node40:
      DependencyIndex: 148
      LevelID: 37
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float  FractalNoise;
            input_float  VoronoiNoise;
            input_float  ShapeMask;
            output_vec4 Cutout;
            
            void main()
            {
            	// Use noise to create cutouts
            	float fractal = step(FractalNoise, 0.0);
            	float voronoi = step(VoronoiNoise, 0.5);
            
            	float cutout = fractal * (1.0 - fractal * voronoi); // range vscale = 2, 5, 5.5
            	if(system.getParticleIndex() % 2 == 0){ cutout = 1.0 - cutout; }
            	cutout *= ShapeMask;
            
            	Cutout = vec4(1.0, 1.0, 1.0, cutout);
            }
        Cutout:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        FractalNoise:
          Connection0:
            NodeLevelID: 8
            PortID: Fractal
          Variable: 0.0
        ID:
          Variable: 37
        Locked:
          Variable: false
        ShapeMask:
