    Node32:
      DependencyIndex: 112
      LevelID: 4
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            input_float TWO_PI;
            input_float SegmentCount;
            input_vec2 UV;
            output_vec2 RadialSymmetryUV;
            
            void main()
            {
                // convert UV to Polar Coordinates [-0.5 to 0.5]
                vec2 shiftUV = UV - 0.5;
                float radius = sqrt(dot(shiftUV, shiftUV)); // Pythagorean Theorem
                float angle = atan(shiftUV.y, shiftUV.x);
            
                // Calculate angle taken up by each radial segment
                float segmentAngle = TWO_PI / SegmentCount;
            
                // calculate UVs position within a single segment
                angle -= segmentAngle * floor(angle / segmentAngle);    // calculate where segment is in base segment
                angle = min(angle, segmentAngle - angle);               // reflect
            
                // convert back to UV coordinates
                RadialSymmetryUV = vec2(cos(angle), sin(angle)) * radius + 0.5;
            }

        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
