    Node33:
      DependencyIndex: 113
      LevelID: 8
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_float ParticleSeed;
            input_vec2 UV;
            output_float Fractal;
            
            void main()
            {
            	int MaxIterations = 4;
            	float Scale = 2.0;
            	
            	// set up seeds and additional variation parameters
            	vec2 seed = system.getParticleRandomVec2(true, false, false, ParticleSeed);
            	vec2 uv = UV;
            	if(int(ParticleSeed * 10.0) % 2 == 0) { uv = 1.0 - UV; }
            
            	vec2 c;
            	vec2 z;
            	c.x = (seed.x + 0.5) * (uv.x + seed.y) * Scale;
            	c.y = (uv.y - 0.5) * Scale;
            
            	// Iterate
            	z = c;
            	int i;
            
            	for(i=0; i<MaxIterations; i++){
            		float x = (z.x * z.x - z.y * z.y) + c.x;
            		float y = (z.y * z.x + z.x * z.y) + c.y;
            
            		if((x * x + y * y) > 2.0) break;
            		z.x = x;
            		z.y = y;
            	}
            
            	if(i == MaxIterations) 	Fractal = 0.0;
            	else 					Fractal = float(i)/float(MaxIterations);
            }
        Description:
          ClassType1: TEXT
          String: "Seed range = (0,1)"
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        Fractal:
          IOType: 1
          Variable: 0.0
        ID:
          Variable: 8
        Locked:
          Variable: false
        ParticleSeed:
          Connection0:
            NodeLevelID: 35
            PortID: Value
          Variable: 0.0
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Simple Fractal (Mandelbrot base)
        UV:
          Connection0:
            NodeLevelID: 4
            PortID: RadialSymmetryUV
          Variable: [0.0, 0.0]
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
