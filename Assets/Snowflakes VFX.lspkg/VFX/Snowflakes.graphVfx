    Node56:
      DependencyIndex: 164
      LevelID: 79
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_bool  UseRamp;
            input_vec4 RampColor;
            input_bool UseIcy;
            input_vec4 IcyColor;
            input_float Iciness;
            output_vec4 Color; 
            
            void main()
            {
            	Color = 	system.getParticleColor();
            
            	if(UseIcy && UseRamp) {
            		Color = mix(RampColor, IcyColor, Iciness) * Color;
            	} else if (UseRamp) {
            		Color *= RampColor;
            	} else if (UseIcy) {
            		Color *= mix(Color, IcyColor, Iciness);
            	}
            
            }
        Color:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : System Built-In Values/Functions"
        ID:
          Variable: 79
        Iciness:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        IcyColor:
          Connection0:
            NodeLevelID: 32
            PortID: Color
          Variable: [0.0, 0.0, 0.0, 0.0]
        Locked:
          Variable: false
        RampColor:
          Connection0:
            NodeLevelID: 44
            PortID: Color
          Variable: [0.0, 0.0, 0.0, 0.0]
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
