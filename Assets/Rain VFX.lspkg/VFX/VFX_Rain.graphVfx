          Title1: Float Import
          Title2: Pivot Point
        Node5:
          DependencyIndex: 80
          LevelID: 111
          NodeCount: 0
          NodeType: 1
          Ports:
            Alignment:
              Connection0:
                NodeLevelID: 48
                PortID: Value
              Variable: 0.0
            Code:
              ClassType1: TEXT
              String: |-
                input_int FacingMode;
                input_int Alignment;
                input_float VelocityStretchAmount;
                input_vec2 PivotPoint;
                
                void main()
                {
                	float Epsilon = 0.03;
                    vec3 quadTangent = vec3(0.0, 1.0, 0.0);
                	float velMag = length(system.getParticleVelocity()); 
                	float velStretch = max(velMag * VelocityStretchAmount, 1.0);
                
                    //T = Quad Tangent ( velocity direction  )
                    if(velMag < Epsilon || VelocityStretchAmount < 0.0001) { //Disable if stretch is small   
                        if(Alignment == 1) quadTangent = system.getCameraUp();
                    }
                    else {
                        quadTangent = normalize(system.getParticleVelocity());
                    }
                
                	//N = Quad Normal ( facing camera )
                    vec3 vertNormal = system.getMatrixCamera()[2].xyz;
                    if (FacingMode == 0) vertNormal = system.getCameraPosition() - system.getParticlePosition();
                    vertNormal = normalize(vertNormal);
                
                    //B = Quad BiTangent ( N dot T  )
                    vec3 quadBitangent = normalize(cross(vertNormal, quadTangent));
                	
                    vec3 vertTangent = normalize(cross(quadBitangent, vertNormal));
                
                	//Use UV to expand vertices to -0.5 to 0.5
                    vec2 expandVerts = system.getSurfaceUVCoord0().xy - vec2(0.5) + PivotPoint;
                    expandVerts = (system.getParticleMatrix() * vec4(expandVerts, 0.0, 1.0)).xy;
                
                    // Create the final vertex position
                    vec3 vertPos = system.getParticlePosition();
                    vertPos += (system.getParticleSize() * expandVerts.x * -quadBitangent);
                    vertPos += (system.getParticleSize() * expandVerts.y * velStretch * vertTangent);
                    
                	// Set Particle Attributes
                    system.setVertexPosition(vertPos); 
                    system.setVertexTangent(vertTangent); 
                    system.setVertexNormal(vertNormal); 
                }
            Description:
              ClassType1: TEXT
              String: ""
            Examples:
              ItemIndex: 0
              ItemList: "Custom : System Built-In Values/Functions"
            FacingMode:
              Connection0:
                NodeLevelID: 47
                PortID: Value
              Variable: 0.0
            ID:
